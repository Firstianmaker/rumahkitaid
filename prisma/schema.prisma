generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  MANAGER
  TENANT
}
enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum LeaseStatus {
  DRAFT
  AWAITING_SIGNATURE
  SIGNED
  VERIFIED
  ACTIVE
  MOVED_OUT
  CLOSED
  CANCELLED
}
enum InvoiceKind {
  RENT
  DEPOSIT
  UTILITY
  FINAL
}
enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String
  passwordHash String
  role Role @default(TENANT)
  createdAt DateTime @default(now())
  sessions Session[]
  applications Application[]
  leases Lease[]
  documents Document[]
  tickets Ticket[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Property {
  id String @id @default("rumahkita")
  name String @default("RumahKita Residence")
  address String @default("Jl. Melati Raya, Bandung")
  bankName String @default("Bank Demo")
  bankAccount String @default("0000000000")
  bankOwner String @default("RumahKita — DEMO")
  electricityRate Decimal @db.Decimal(12,2) @default(1500)
  waterRate Decimal @db.Decimal(12,2) @default(5000)
  units Unit[]
}
model Unit {
  id String @id @default(cuid())
  propertyId String @default("rumahkita")
  property Property @relation(fields:[propertyId], references:[id])
  code String @unique
  name String
  description String @db.Text
  rent Decimal @db.Decimal(14,2)
  deposit Decimal @db.Decimal(14,2)
  area Int
  bedrooms Int
  bathrooms Int @default(1)
  image String?
  amenities Json
  status UnitStatus @default(AVAILABLE)
  applications Application[]
  leases Lease[]
  createdAt DateTime @default(now())
}
model Application {
  id String @id @default(cuid())
  unitId String
  tenantId String
  unit Unit @relation(fields:[unitId], references:[id])
  tenant User @relation(fields:[tenantId], references:[id])
  moveInDate DateTime @db.Date
  occupants Int
  occupation String
  currentAddress String? @db.Text
  employmentType String?
  employerName String?
  monthlyIncome Decimal? @db.Decimal(14,2)
  incomeSource String?
  incomeDocumentId String?
  householdType String?
  adultCount Int?
  childCount Int?
  elderlyCount Int?
  petCount Int?
  petTypes Json?
  petNotes String? @db.Text
  notes String? @db.Text
  reason String?
  status ApplicationStatus @default(PENDING)
  lease Lease?
  createdAt DateTime @default(now())
  @@index([tenantId, status])
}
model Lease {
  id String @id @default(cuid())
  applicationId String @unique
  application Application @relation(fields:[applicationId], references:[id])
  unitId String
  tenantId String
  unit Unit @relation(fields:[unitId], references:[id])
  tenant User @relation(fields:[tenantId], references:[id])
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  months Int
  dueDay Int
  rent Decimal @db.Decimal(14,2)
  deposit Decimal @db.Decimal(14,2)
  status LeaseStatus @default(DRAFT)
  createdAt DateTime @default(now())
  movedOutAt DateTime?
  invoices Invoice[]
  contracts ContractVersion[]
  meters MeterReading[]
  inspections Inspection[]
  depositEntries DepositEntry[]
  tickets Ticket[]
  @@index([tenantId, status])
}
model Document {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id])
  name String
  mime String
  size Int
  key String @unique
  createdAt DateTime @default(now())
}
model ContractVersion {
  id String @id @default(cuid())
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  documentId String
  kind String
  version Int
  createdAt DateTime @default(now())
  @@unique([leaseId, version])
}
model Invoice {
  id String @id @default(cuid())
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  kind InvoiceKind
  period String
  label String
  amount Decimal @db.Decimal(14,2)
  depositApplied Decimal @db.Decimal(14,2) @default(0)
  dueDate DateTime @db.Date
  status InvoiceStatus @default(UNPAID)
  items Json
  createdAt DateTime @default(now())
  payments Payment[]
  @@unique([leaseId, kind, period])
  @@index([status, dueDate])
}
model Payment {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId], references:[id])
  documentId String?
  amount Decimal @db.Decimal(14,2)
  status PaymentStatus @default(PENDING)
  simulated Boolean @default(false)
  reason String?
  reviewedBy String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
}
model MeterReading {
  id String @id @default(cuid())
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  period String
  electricityStart Decimal @db.Decimal(14,3)
  electricityEnd Decimal @db.Decimal(14,3)
  waterStart Decimal @db.Decimal(14,3)
  waterEnd Decimal @db.Decimal(14,3)
  electricityRate Decimal @db.Decimal(12,2)
  waterRate Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  @@unique([leaseId, period])
}
model Inspection {
  id String @id @default(cuid())
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  kind String
  checklist Json
  notes String @db.Text
  documentIds Json
  electricity Decimal @db.Decimal(14,3)
  water Decimal @db.Decimal(14,3)
  completedAt DateTime @default(now())
  @@unique([leaseId, kind])
}
model DepositEntry {
  id String @id @default(cuid())
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  kind String
  amount Decimal @db.Decimal(14,2)
  reason String
  reference String @unique
  createdAt DateTime @default(now())
}
model Ticket {
  id String @id @default(cuid())
  tenantId String
  tenant User @relation(fields:[tenantId], references:[id])
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  title String
  description String @db.Text
  priority String
  status TicketStatus @default(OPEN)
  documentIds Json
  comments Comment[]
  createdAt DateTime @default(now())
}
model Comment {
  id String @id @default(cuid())
  ticketId String
  ticket Ticket @relation(fields:[ticketId], references:[id])
  authorId String
  authorName String
  text String @db.Text
  createdAt DateTime @default(now())
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String @db.Text
  unitId String?
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}
