{
  "name": "@rumahkita/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/domain.test.ts",
    "test:integration": "npm run build && tsx --test --test-concurrency=1 test/api.integration.test.ts",
    "openapi": "npm run build && node dist/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3"
  }
}
