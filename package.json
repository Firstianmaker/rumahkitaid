{
  "name": "rumahkita",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @rumahkita/api",
    "dev:web": "npm run dev -w @rumahkita/web",
    "build": "npm run build -w @rumahkita/api && npm run build -w @rumahkita/web",
    "test": "npm run test -w @rumahkita/api",
    "test:integration": "npm run test:integration -w @rumahkita/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "api:types": "openapi-typescript packages/api-client/openapi.json -o packages/api-client/schema.d.ts",
    "test:e2e": "npm run test:e2e -w @rumahkita/web"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "openapi-typescript": "^7.10.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.0"
  }
}
